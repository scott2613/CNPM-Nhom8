# Copy to .env.runtime on the server. Never commit actual secrets.
ConnectionStrings__DefaultConnection=Server=YOUR_SQL_HOST,1433;Database=AudioGuideDb;User Id=YOUR_SQL_USER;Password=SET_SECRET;Encrypt=True;TrustServerCertificate=False;
Security__AdminApiKey=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
Security__AdminUsername=admin
Security__AdminPasswordHash=GENERATE_WITH_tools_HashPassword
PublicBaseUrl=https://guide.example.edu.vn
AllowedHosts=guide.example.edu.vn;admin.example.edu.vn;api;localhost;127.0.0.1
Translation__ApiKey=
# Set only to your actual reverse proxy address, not 0.0.0.0 or arbitrary clients.
Proxy__KnownProxies__0=127.0.0.1
