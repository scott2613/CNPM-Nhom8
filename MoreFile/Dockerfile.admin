FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore AudioGuide.Admin/AudioGuide.Admin.csproj --locked-mode && dotnet publish AudioGuide.Admin/AudioGuide.Admin.csproj -c Release --no-restore -o /out
FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /out ./
ENV ASPNETCORE_HTTP_PORTS=8080
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet","AudioGuide.Admin.dll"]
