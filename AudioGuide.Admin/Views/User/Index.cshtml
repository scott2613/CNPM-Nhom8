@* Định nghĩa kiểu dữ liệu danh sách bản ghi nhật ký người dùng *@
@model IEnumerable<AudioGuide.Admin.Controllers.UserAccessLogViewModel>

@{
    ViewData["Title"] = "Giám Sát Truy Cập Thực Tế";
}

<style>
    /* Thẻ Card gương lỏng hiển thị chỉ số thống kê */
    .liquid-card {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.52) 0%, rgba(255, 255, 255, 0.18) 100%);
        backdrop-filter: blur(25px) saturate(210%);
        -webkit-backdrop-filter: blur(25px) saturate(210%);
        border: 1.5px solid rgba(255, 255, 255, 0.9);
        box-shadow: 0 16px 36px -6px rgba(14, 116, 144, 0.12), inset 0 2px 3px 0 rgba(255, 255, 255, 0.95);
        border-radius: 26px;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
    }

        .liquid-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 22px 45px -8px rgba(14, 116, 144, 0.18), inset 0 2px 3px 0 rgba(255, 255, 255, 1);
        }

    /* Khung bảng hiển thị dữ liệu nhật ký dạng gương lỏng */
    .liquid-table-container {
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.58) 0%, rgba(255, 255, 255, 0.22) 100%);
        backdrop-filter: blur(30px) saturate(220%);
        -webkit-backdrop-filter: blur(30px) saturate(220%);
        border: 1.5px solid rgba(255, 255, 255, 0.95);
        border-radius: 30px;
        box-shadow: 0 18px 42px -8px rgba(14, 116, 144, 0.12), inset 0 2px 4px 0 rgba(255, 255, 255, 0.95);
        overflow: visible;
    }

    .table-liquid {
        margin-bottom: 0;
    }

        .table-liquid thead tr {
            background: rgba(255, 255, 255, 0.3);
            border-bottom: 1.5px solid rgba(226, 232, 240, 0.7);
        }

        .table-liquid thead th {
            font-weight: 700;
            letter-spacing: 0.04em;
        }

        .table-liquid tbody tr {
            transition: all 0.2s ease;
            border-bottom: 1px solid rgba(241, 245, 249, 0.7);
        }

            .table-liquid tbody tr:hover {
                background: rgba(255, 255, 255, 0.55) !important;
            }

    /* Huy hiệu trạng thái kết nối bộ nhớ RAM thời gian thực */
    .radar-lens-badge {
        background: linear-gradient(135deg, rgba(236, 253, 245, 0.85) 0%, rgba(209, 250, 229, 0.45) 100%);
        backdrop-filter: blur(16px) saturate(200%);
        border: 1.5px solid rgba(167, 243, 208, 0.9);
        color: #047857;
        font-weight: 700;
        font-size: 13px;
        padding: 8px 18px;
        border-radius: 9999px;
        box-shadow: 0 8px 20px -4px rgba(16, 185, 129, 0.2), inset 0 2px 3px rgba(255, 255, 255, 0.95);
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    /* Viên thuốc hiển thị mã phiên của thiết bị */
    .poi-id-pill {
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
        font-weight: 800;
        font-size: 13px;
        color: #0284c7;
        background: rgba(255, 255, 255, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.9);
        padding: 4px 12px;
        border-radius: 9999px;
        display: inline-block;
        box-shadow: 0 4px 10px rgba(14, 116, 144, 0.08), inset 0 1px 2px rgba(255, 255, 255, 0.8);
    }

    /* Nhãn hiển thị địa chỉ IP của thiết bị */
    .badge-scan-liquid {
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
        font-weight: 700;
        color: #1e293b;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(255, 255, 255, 0.9);
        padding: 5px 12px;
        border-radius: 9999px;
        font-size: 12.5px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02), inset 0 1px 2px rgba(255, 255, 255, 0.8);
    }

    /* Nhãn hiển thị ngôn ngữ */
    .status-badge-active {
        background: rgba(236, 253, 245, 0.82) !important;
        color: #059669 !important;
        border: 1px solid rgba(167, 243, 208, 0.9) !important;
        padding: 5px 12px;
        border-radius: 9999px;
        font-weight: 700;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        box-shadow: 0 4px 10px rgba(16, 185, 129, 0.08);
    }

    /* Biểu tượng trong các thẻ thống kê */
    .stat-icon-liquid {
        width: 52px;
        height: 52px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        border: 1.5px solid rgba(255, 255, 255, 0.9);
        box-shadow: inset 0 2px 3px rgba(255, 255, 255, 0.95);
        flex-shrink: 0;
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Tiêu đề trang và huy hiệu radar trạng thái thời gian thực -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2 text-dark">
                <i class="bi bi-activity text-primary"></i> Giám Sát Truy Cập Thời Gian Thực
            </h2>
            <p class="text-secondary fs-7 mb-0">Hệ thống theo dõi luồng khách tham quan quét mã QR và nghe thuyết minh trực tiếp.</p>
        </div>
        <div>
            <span class="radar-lens-badge">
                <span class="spinner-grow spinner-grow-sm text-success" role="status" aria-hidden="true"></span>
                Kết Nối Real-time Tracker (RAM)
            </span>
        </div>
    </div>

    <!-- 1. Bốn thẻ Card hiển thị các chỉ số thời gian thực -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="liquid-card p-3 d-flex align-items-center">
                <div class="stat-icon-liquid bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-qr-code-scan"></i>
                </div>
                <div class="ms-3">
                    <span class="text-uppercase text-secondary font-monospace fw-semibold" style="font-size: 11px;">TỔNG LƯỢT QUÉT HÔM NAY</span>
                    <h3 class="fw-bold mb-0 text-dark" id="txtTotalScans">@ViewBag.TotalScansToday</h3>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="liquid-card p-3 d-flex align-items-center">
                <div class="stat-icon-liquid bg-success bg-opacity-10 text-success">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="ms-3">
                    <span class="text-uppercase text-secondary font-monospace fw-semibold" style="font-size: 11px;">ĐANG TRUY CẬP (REALTIME)</span>
                    <h3 class="fw-bold mb-0 text-success" id="txtActiveUsers">
                        @ViewBag.ActiveUsersNow <small class="fs-6 fw-normal text-muted">khách</small>
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="liquid-card p-3 d-flex align-items-center">
                <div class="stat-icon-liquid bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-fire"></i>
                </div>
                <div class="ms-3">
                    <span class="text-uppercase text-secondary font-monospace fw-semibold" style="font-size: 11px;">ĐỊA ĐIỂM HOT NHẤT</span>
                    <h5 class="fw-bold mb-0 text-dark text-truncate" style="max-width: 190px;" id="txtTopPoi">@ViewBag.TopPoi</h5>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="liquid-card p-3 d-flex align-items-center">
                <div class="stat-icon-liquid bg-info bg-opacity-10 text-info">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="ms-3">
                    <span class="text-uppercase text-secondary font-monospace fw-semibold" style="font-size: 11px;">GIỜ CAO ĐIỂM HÔM NAY</span>
                    <h5 class="fw-bold mb-0 text-dark" id="txtPeakHour">@ViewBag.PeakHour</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng theo dõi các phiên khách tham quan đang trực tuyến trên RAM -->
    <div class="liquid-table-container p-4">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-light-subtle">
            <div>
                <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-hdd-network text-primary"></i> Nhật Ký Người Dùng Đang Online
                </h5>
                <small class="text-muted">💡 <i>Dữ liệu cập nhật tự động mỗi 3 giây từ bộ nhớ RAM đệm của hệ thống API.</i></small>
            </div>
            <button type="button" class="btn-liquid-lens" onclick="location.reload();">
                <i class="bi bi-arrow-clockwise"></i> Tải Lại
            </button>
        </div>

        <div class="table-responsive" style="overflow: visible;">
            <div id="realtimeReadError" class="alert alert-warning d-none" role="status"></div>
            <table class="table table-liquid align-middle" data-paginate="phiên đang truy cập">
                <thead>
                    <tr class="text-uppercase fs-7 text-secondary">
                        <th class="py-3 text-center" style="width: 110px;">Mã Phiên</th>
                        <th class="py-3">Trạng Thái & Địa Điểm Thuyết Minh</th>
                        <th class="py-3">Địa Chỉ IP</th>
                        <th class="py-3">Thiết Bị Thực Tế</th>
                        <th class="py-3 text-center">Ngôn Ngữ</th>
                        <th class="py-3 text-end" style="width: 180px;">Cập Nhật Cuối</th>
                    </tr>
                </thead>
                <tbody id="liveLogTableBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <span class="poi-id-pill">#@log.Id</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@log.PoiName</div>
                                    <small class="text-secondary font-monospace" style="font-size: 11px;">Mã: @log.PoiCode</small>
                                </td>
                                <td>
                                    <span class="badge-scan-liquid font-monospace">@log.IpAddress</span>
                                </td>
                                <td class="text-secondary fw-semibold small">@log.Device</td>
                                <td class="text-center">
                                    <span class="status-badge-active" style="font-size: 11.5px;">@log.Lang</span>
                                </td>
                                <td class="text-end text-muted small font-monospace">@log.ScannedAt</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyRow">
                            <td colspan="6" class="text-center py-5 text-muted fs-6">Chưa có thiết bị nào đang truy cập hệ thống.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // Khởi tạo tác vụ Polling thời gian thực khi trang tải xong
    document.addEventListener("DOMContentLoaded", function () {
        let metricsPending = false;

        // Hàm truy vấn số liệu thống kê thời gian thực từ API
        function fetchMetrics() {
            // Tạm ngưng gửi yêu cầu nếu tab trình duyệt đang bị ẩn
            if (document.hidden || metricsPending) return;
            metricsPending = true;
            const notice = document.getElementById('realtimeReadError');
            adminJson('/User/GetRealtimeMetrics', { cache: 'no-store' })
                .then(data => {
                    if (!Array.isArray(data?.logs)) throw new Error("Phản hồi phiên không hợp lệ.");
                    notice.classList.add("d-none");
                    // 1. Cập nhật số liệu trên 4 thẻ Card chỉ số
                    if (data.totalScansToday !== undefined) {
                        const el = document.getElementById('txtTotalScans');
                        if (el) el.innerText = data.totalScansToday;
                    }
                    if (data.activeUsersNow !== undefined) {
                        const el = document.getElementById('txtActiveUsers');
                        if (el) el.innerHTML = data.activeUsersNow + ' <small class="fs-6 fw-normal text-muted">khách</small>';
                    }
                    if (data.topPoi) {
                        const el = document.getElementById('txtTopPoi');
                        if (el) el.innerText = data.topPoi;
                    }
                    if (data.peakHour) {
                        const el = document.getElementById('txtPeakHour');
                        if (el) el.innerText = data.peakHour;
                    }

                    // 2. Cập nhật lại các dòng trong bảng nhật ký online
                    const tableBody = document.getElementById('liveLogTableBody');
                    if (!tableBody) return;

                    if (data.logs && data.logs.length > 0) {
                        let rowsHtml = '';
                        data.logs.forEach(log => {
                            rowsHtml += `
                                <tr>
                                    <td class="text-center">
                                        <span class="poi-id-pill">#${escapeHtml(log.id)}</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark fs-6">${escapeHtml(log.poiName || 'Đang xem bản đồ')}</div>
                                        <small class="text-secondary font-monospace" style="font-size: 11px;">Mã: ${escapeHtml(log.poiCode || 'N/A')}</small>
                                    </td>
                                    <td>
                                        <span class="badge-scan-liquid font-monospace">${escapeHtml(log.ipAddress || '127.0.0.1')}</span>
                                    </td>
                                    <td class="text-secondary fw-semibold small">${escapeHtml(log.device || 'Thiết bị di động')}</td>
                                    <td class="text-center">
                                        <span class="status-badge-active" style="font-size: 11.5px;">${escapeHtml(log.lang || '🇻🇳 Tiếng Việt')}</span>
                                    </td>
                                    <td class="text-end text-muted small font-monospace">${escapeHtml(log.scannedAt)}</td>
                                </tr>
                            `;
                        });
                        tableBody.innerHTML = rowsHtml;
                    } else {
                        tableBody.innerHTML = `
                            <tr id="emptyRow">
                                <td colspan="6" class="text-center py-5 text-muted fs-6">Chưa có thiết bị nào đang truy cập hệ thống.</td>
                            </tr>
                        `;
                    }
                })
                .catch(() => {
                    notice.textContent = "Không cập nhật được số liệu trực tiếp. Bảng bên dưới có thể đã cũ.";
                    notice.classList.remove("d-none");
                })
                .finally(() => { metricsPending = false; });
        }

        // Bắt đầu chu kỳ thăm dò dữ liệu mỗi 3 giây
        setInterval(fetchMetrics, 3000);

        // Lắng nghe sự kiện chuyển tab để khôi phục thăm dò ngay lập tức
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') {
                fetchMetrics();
            }
        });
    });
</script>
