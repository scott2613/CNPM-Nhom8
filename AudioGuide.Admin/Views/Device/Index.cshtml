    }

        .btn-back-bubble:hover {
            transform: translateX(-3px) scale(1.06);
            background: linear-gradient(135deg, #ffffff 0%, rgba(224, 242, 254, 0.95) 100%);
            color: #0369a1;
            box-shadow: 0 12px 25px -4px rgba(2, 132, 199, 0.25);
        }

    /* 3. THẺ THỐNG KÊ LIQUID GLASS */
