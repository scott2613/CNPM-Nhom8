<!-- 3. MODAL CHẨN ĐOÁN KẾT NỐI -->
<div class="modal fade liquid-modal" id="adminDiagnosticModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 p-3">
            <div class="modal-header border-bottom border-light-subtle pb-3">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn-back-bubble" data-bs-dismiss="modal" title="Quay lại">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2 mb-0">
                        <span class="p-2 rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex">
                            <i class="bi bi-hdd-network"></i>
                        </span>
                        Chẩn Đoán Kết Nối SQL Server & API
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-3">
                <div id="diagLoadingAdmin" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-secondary small mt-2">Đang truy vấn trực tiếp CSDL SQL Server...</p>
                </div>

                <div id="diagResultAdmin" class="d-none">
                    <div class="p-3 mb-3 rounded-4 border bg-white bg-opacity-60 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark small"><i class="bi bi-database-fill text-primary me-1"></i>SQL Server:</span>
                            <span id="diagDbBadgeAdmin" class="badge rounded-pill px-3 py-1.5 font-monospace">Kiểm tra...</span>
                        </div>
                        <div class="small text-secondary font-monospace" style="font-size: 11.5px; line-height: 1.65;">
                            <div>• Máy chủ: <b class="text-dark" id="diagDbServerAdmin">-</b></div>
                            <div>• Database: <b class="text-dark" id="diagDbNameAdmin">-</b></div>
                            <div>• Độ trễ truy vấn: <b class="text-success" id="diagDbPingAdmin">0 ms</b></div>
                        </div>
                    </div>

                    <div class="p-3 rounded-4 border bg-white bg-opacity-60 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark small"><i class="bi bi-cpu-fill text-info me-1"></i>Máy Chủ API:</span>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-3 py-1.5" id="diagApiBadgeDevice">Đang kiểm tra</span>
                        </div>
                        <div class="small text-secondary font-monospace" style="font-size: 11.5px; line-height: 1.65;">
                            <div>• Host đang chạy: <b class="text-dark" id="diagApiHostAdmin">-</b></div>
                            <div>• Lần kiểm tra cuối: <b class="text-dark" id="diagTimestampAdmin">-</b></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top-0 pt-0 d-flex justify-content-between">
                <small class="text-muted" style="font-size: 11px;">💡 Kết nối với bảng [DeviceSessions] trong CSDL.</small>
                <button type="button" class="btn-liquid-lens py-1.5 px-3" onclick="fetchDiagnosticDataAdmin()">
                    <i class="bi bi-arrow-clockwise"></i> Thử lại
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let deviceDetailModalInstance, diagnosticModalAdminInstance, historyModalInstance;
    let currentHistoryRange = '24h';
    let currentActiveRow = null;

    document.addEventListener("DOMContentLoaded", function () {
        deviceDetailModalInstance = new bootstrap.Modal(document.getElementById('deviceDetailModal'));
        diagnosticModalAdminInstance = new bootstrap.Modal(document.getElementById('adminDiagnosticModal'));
        historyModalInstance = new bootstrap.Modal(document.getElementById('userHistoryModal'));

        setInterval(refreshDevicePresence, 5000);
        document.addEventListener('visibilitychange', refreshDevicePresence);
        refreshDevicePresence();
    });

    let presenceRequestPending = false;

    function renderDeviceStatus(target, blocked, online) {
        const badge = document.createElement('span');
        badge.className = blocked ? 'status-badge-maint' :
            online === null ? 'badge bg-secondary' :
            online ? 'status-badge-active' : 'status-badge-offline';
        badge.textContent = blocked ? 'Đang chặn' :
            online === null ? 'Chưa xác định' : online ? 'Hoạt động' : 'Ngoại tuyến';
        target.replaceChildren(badge);
    }

    async function refreshDevicePresence() {
        if (document.hidden || presenceRequestPending) return;
        presenceRequestPending = true;
        let statuses = null;
        try {
            const rows = await adminJson('/Device/Presence', {
                cache: 'no-store', signal: AbortSignal.timeout(8000)
            });
            if (!Array.isArray(rows)) throw new Error('Phản hồi phiên không hợp lệ');
            statuses = new Map(rows.map(row => [String(row.id), row]));
        } catch (error) {
            console.warn('Không đọc được trạng thái phiên thiết bị.', error);
        } finally {
            presenceRequestPending = false;
        }

        let count = 0;
        document.querySelectorAll('#deviceMainTable tbody tr[data-fingerprint]').forEach(row => {
            const status = statuses?.get(row.dataset.id);
            const blocked = status?.isBlocked ?? (row.dataset.blocked === 'true');
            const online = status ? status.isOnline : null;
            row.dataset.blocked = String(blocked);
            if (online) count++;
            row.dataset.online = online === null ? 'unknown' : String(online);
            renderDeviceStatus(row.querySelector('[data-device-status]'), blocked, online);
            if (currentActiveRow === row)
                renderDeviceStatus(document.getElementById('detailDeviceStatus'), blocked, online);
        });
        document.getElementById('activeDeviceCount').textContent = statuses ? count : '—';
    }

    // LỌC BẢNG THIẾT BỊ THEO TẤT CẢ CÁC TRƯỜNG
    function filterDeviceTable() {
        const searchEl = document.getElementById("deviceSearchInput");
        const clearBtn = document.getElementById("clearSearchBtn");
        const input = searchEl.value.toLowerCase().trim();

        if (clearBtn) {
            clearBtn.style.display = input.length > 0 ? "inline-flex" : "none";
        }

        const rows = document.querySelectorAll("#deviceMainTable tbody tr");
        rows.forEach(row => {
            const fingerprint = (row.getAttribute("data-fingerprint") || "").toLowerCase();
            const name = (row.getAttribute("data-name") || "").toLowerCase();
            const ip = (row.getAttribute("data-ip") || "").toLowerCase();
            const platform = (row.getAttribute("data-platform") || "").toLowerCase();
            const browser = (row.getAttribute("data-browser") || "").toLowerCase();

            if (!input || fingerprint.includes(input) || name.includes(input) || ip.includes(input) || platform.includes(input) || browser.includes(input)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
        window.refreshAdminPagination?.("deviceMainTable", true);
    }

    function clearDeviceSearch() {
        const searchEl = document.getElementById("deviceSearchInput");
        searchEl.value = "";
        filterDeviceTable();
        searchEl.focus();
    }

    // ĐỒNG BỘ THIẾT BỊ
    function syncDevices(btn) {
        const icon = document.getElementById("syncDeviceIcon");
        if (icon) icon.classList.add("spin-fast");
        btn.style.pointerEvents = "none";

        adminJson('/Device/SyncDevices', { method: 'POST' })
            .then(data => {
                alert("✓ " + (data.message || "Đã làm mới danh sách thiết bị."));
                location.reload();
            })
            .catch(err => {
                alert("Lỗi làm mới thiết bị: " + err.message);
                btn.style.pointerEvents = "";
                icon?.classList.remove("spin-fast");
            });
    }

    // BẬT / TẮT CHẶN THIẾT BỊ
    function toggleBlockDevice(id) {
        adminJson(`/Device/ToggleBlock?id=${id}`, { method: 'POST' })
            .then(data => {
                alert("✓ " + (data.message || "Đã cập nhật trạng thái thiết bị thành công!"));
                location.reload();
            })
            .catch(err => alert("Lỗi cập nhật trạng thái: " + err.message));
    }

    // XÓA THIẾT BỊ
    function deleteDevice(id) {
        if (confirm("Bạn có chắc chắn muốn xóa thiết bị này khỏi danh sách quản lý?")) {
            adminJson(`/Device/DeleteDevice?id=${id}`, { method: 'DELETE' })
                    .then(data => {
                    alert("✓ " + (data.message || "Đã xóa thiết bị thành công!"));
                    location.reload();
                })
                .catch(err => alert("Lỗi xóa thiết bị: " + err.message));
        }
    }

    // HIỂN THỊ MODAL CHI TIẾT
    function openDetailModal(row) {
        currentActiveRow = row;
        const fingerprint = row.getAttribute('data-fingerprint');
        const name = row.getAttribute('data-name');
        const ip = row.getAttribute('data-ip');
        const platform = row.getAttribute('data-platform');
        const browser = row.getAttribute('data-browser');
        const scans = row.getAttribute('data-scans');
        const isBlocked = row.getAttribute('data-blocked') === 'true';
        const isOnline = row.getAttribute('data-online') === 'true';
        const lastActive = row.getAttribute('data-lastactive');

        document.getElementById('detailDeviceFingerprint').innerText = '#' + fingerprint;
        document.getElementById('detailDeviceName').innerText = name;
        document.getElementById('detailDeviceIp').innerText = ip;
        document.getElementById('detailDevicePlatform').innerText = platform;
        document.getElementById('detailDeviceBrowser').innerText = browser;
        document.getElementById('detailDeviceScans').innerText = scans + ' lượt';
        document.getElementById('detailDeviceLastActive').innerText = lastActive;

        renderDeviceStatus(document.getElementById('detailDeviceStatus'),
            isBlocked, row.dataset.online === 'unknown' ? null : isOnline);

        deviceDetailModalInstance.show();
    }

    function openDetailFromDropdown(btn) {
        const row = btn.closest('tr');
        if (row) openDetailModal(row);
    }

    function deleteDeviceFromDetail() {
        if (!currentActiveRow) return;
        const id = currentActiveRow.getAttribute('data-id');
        deviceDetailModalInstance.hide();
        deleteDevice(id);
    }

    // LOGIC LỊCH SỬ TRUY CẬP
    function selectHistoryRange(range, label, btnEl) {
        currentHistoryRange = range;
        document.getElementById('selectedRangeText').innerText = label;

        document.querySelectorAll('#userHistoryModal .btn-range-mini-pill').forEach(b => b.classList.remove('active'));
        if (btnEl) btnEl.classList.add('active');

        fetchUserHistory(range);
    }

    function openUserHistoryModal(range = '24h') {
        currentHistoryRange = range;
        historyModalInstance.show();
        fetchUserHistory(range);
    }

    let historyRequest = 0;
    function fetchUserHistory(range) {
        document.getElementById('historyLoading').classList.remove('d-none');
        document.getElementById('historyContent').classList.add('d-none');

        const request = ++historyRequest;
        adminJson(`/Device/GetUserAccessHistory?range=${encodeURIComponent(range)}`)
            .then(data => {
                if (request !== historyRequest) return;
                if (!Array.isArray(data)) throw new Error("Phản hồi lịch sử không hợp lệ.");
                const tbody = document.getElementById('historyTableBody');
                tbody.innerHTML = '';

                if (!data || !Array.isArray(data) || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">Chưa có lịch sử truy cập nào trong khung thời gian này.</td></tr>';
                } else {
                    data.forEach(user => {
                        let listItemsHtml = '';
                        if (user.details && user.details.length > 0) {
                            user.details.forEach(item => {
                                listItemsHtml += `
                                    <li class="d-flex justify-content-between align-items-center liquid-history-item">
                                        <span class="small fw-semibold text-dark text-truncate me-2" style="max-width: 200px;">📍 ${escapeHtml(item.poiName)}</span>
                                        <span class="badge-scan-count font-monospace">${item.count} lần</span>
                                    </li>`;
                            });
                        } else {
                            listItemsHtml = '<li class="text-muted small p-2">Chưa có chi tiết</li>';
                        }

                        const bubbleMenuHtml = `
                            <div class="dropdown d-inline-block">
                                <button class="btn-bubble-eye"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        data-bs-boundary="viewport"
                                        aria-expanded="false"
                                        title="Bấm để xem danh sách địa điểm đã xem">
                                    <i class="bi bi-eye-fill"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end liquid-dropdown-menu shadow-lg border-0">
                                    <li class="small fw-bold text-secondary px-2 pb-1 border-bottom border-light-subtle mb-1">
                                        📌 Địa điểm đã mở (${user.details ? user.details.length : 0})
                                    </li>
                                    ${listItemsHtml}
                                </ul>
                            </div>`;

                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="px-3">
                                <div class="fw-bold font-monospace text-dark">${escapeHtml(user.ipAddress || 'Ẩn danh')}</div>
                                <small class="text-muted">${escapeHtml(user.device || 'Thiết bị không xác định')}</small>
                            </td>
                            <td class="text-center fw-bold text-primary fs-5 font-monospace">${user.totalScans ?? 0}</td>
                            <td class="text-center small text-muted font-monospace">${escapeHtml(user.lastAccess || '-')}</td>
                            <td class="text-center">${bubbleMenuHtml}</td>
                        `;
                        tbody.appendChild(tr);
                    });
                }

                window.refreshAdminPagination?.('deviceHistoryTable', true);
                document.getElementById('historyLoading').classList.add('d-none');
                document.getElementById('historyContent').classList.remove('d-none');
            })
            .catch(err => {
                if (request !== historyRequest) return;
                document.getElementById('historyLoading').classList.add('d-none');
                document.getElementById('historyContent').classList.remove('d-none');
                const tbody = document.getElementById('historyTableBody');
                tbody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-danger">Không tải được lịch sử: ${escapeHtml(err.message)}</td></tr>`;
            });
    }

    // CHẨN ĐOÁN KẾT NỐI
    function openDiagnosticModal() {
        diagnosticModalAdminInstance.show();
        fetchDiagnosticDataAdmin();
    }

    function fetchDiagnosticDataAdmin() {
        const loading = document.getElementById('diagLoadingAdmin');
        const result = document.getElementById('diagResultAdmin');
        loading.classList.remove('d-none');
        result.classList.add('d-none');

        adminJson('/Home/CheckHealth')
            .then(data => {
                const apiBadge = document.getElementById('diagApiBadgeDevice');
                apiBadge.className = 'badge bg-success';
                apiBadge.textContent = 'Online';
                loading.classList.add('d-none');
                result.classList.remove('d-none');

                const isDbOk = data.database && data.database.status === 'Connected';
                const dbBadge = document.getElementById('diagDbBadgeAdmin');
                dbBadge.className = isDbOk
                    ? 'badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-3 py-1.5'
                    : 'badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-3 py-1.5';
                dbBadge.innerText = isDbOk ? 'Đã kết nối và truy vấn' :
                    data.database?.status === 'QueryFailed' ? 'SQL cần kiểm tra' : 'Chưa kết nối SQL';

                document.getElementById('diagDbServerAdmin').innerText = data.database?.server || 'N/A';
                document.getElementById('diagDbNameAdmin').innerText = data.database?.database || 'N/A';
                document.getElementById('diagDbPingAdmin').innerText = (data.database?.responseTimeMs ?? 0) + ' ms';
                document.getElementById('diagApiHostAdmin').innerText = (data.api?.scheme || 'http') + '://' + (data.api?.host || 'localhost');
                document.getElementById('diagTimestampAdmin').innerText = data.timestamp || new Date().toLocaleTimeString();
            })
            .catch(err => {
                const apiBadge = document.getElementById('diagApiBadgeDevice');
                apiBadge.className = 'badge bg-secondary';
                apiBadge.textContent = 'Chưa xác định';
                document.getElementById('diagApiHostAdmin').textContent = '—';
                document.getElementById('diagTimestampAdmin').textContent = '—';
                loading.classList.add('d-none');
                result.classList.remove('d-none');
                const dbBadge = document.getElementById('diagDbBadgeAdmin');
                dbBadge.className = 'badge bg-danger text-white rounded-pill px-3 py-1.5';
                dbBadge.innerText = 'Lỗi kết nối';
            });
    }
</script>
