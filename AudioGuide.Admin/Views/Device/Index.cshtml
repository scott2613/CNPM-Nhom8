        }

    .liquid-dropdown-menu {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.6) 100%) !important;
        backdrop-filter: blur(28px) saturate(190%) !important;
        -webkit-backdrop-filter: blur(28px) saturate(190%) !important;
        border: 1.5px solid rgba(255, 255, 255, 0.95) !important;
        border-radius: 22px !important;
        box-shadow: 0 20px 50px -10px rgba(15, 23, 42, 0.22), inset 0 2px 4px 0 rgba(255, 255, 255, 1) !important;
