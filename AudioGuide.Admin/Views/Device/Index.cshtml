        border-radius: 16px !important;
        padding: 8px 12px;
        margin-bottom: 6px;
    }

    .badge-scan-count {
        background: linear-gradient(135deg, rgba(2, 132, 199, 0.12) 0%, rgba(56, 189, 248, 0.22) 100%) !important;
        color: #0284c7 !important;
        border: 1px solid rgba(56, 189, 248, 0.35) !important;
