        display: flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        border: none;
        width: 100%;
        text-align: left;
        color: #334155;
        transition: all 0.2s ease;
    }

        .liquid-dropdown-item:hover {
            background: rgba(2, 132, 199, 0.1) !important;
            color: #0284c7 !important;
            transform: translateX(3px);
