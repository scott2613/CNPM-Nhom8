@* Khai báo Model danh sách thiết bị từ DeviceController *@
@model IEnumerable<AudioGuide.Admin.Controllers.DeviceViewModel>

@{
    ViewData["Title"] = "Quản lý thiết bị truy cập & phiên làm việc";

    // 1. LẤY MỐC GIỜ VIỆT NAM HIỆN TẠI ĐỒNG NHẤT VỚI DATABASE (GMT+7)
    var nowVn = DateTime.UtcNow;

    // 2. TÍNH TOÁN THỐNG KÊ NHANH
    // Thiết bị được coi là Đang hoạt động nếu không bị chặn và có tương tác trong vòng 20 giây trở lại
    var totalDevices = Model?.Count() ?? 0;
    var activeDevices = Model?.Count(d => !d.IsBlocked && d.IsOnline) ?? 0;
    var blockedDevices = Model?.Count(d => d.IsBlocked) ?? 0;
    var totalScans = Model?.Sum(d => d.TotalScans) ?? 0;

    // Sắp xếp danh sách ưu tiên thiết bị mới hoạt động gần nhất lên đầu
    var sortedDevices = Model?.OrderByDescending(d => d.LastActiveAt).ToList();
}

<style>
    /* 1. NỀN QUANG HỌC DỊU NHẸ & THỦY TINH LỎNG TỔNG THỂ */


    .modal-backdrop.show {
        background: rgba(15, 23, 42, 0.22) !important;
        backdrop-filter: blur(16px) saturate(140%) !important;
        -webkit-backdrop-filter: blur(16px) saturate(140%) !important;
        opacity: 1 !important;
    }

    /* 2. HIỆU ỨNG ANIMATION THU PHÓNG MULTITASKING CỦA MODAL */
    .liquid-modal .modal-dialog {
        transform: scale(0.88) translateY(28px);
        opacity: 0;
        transition: transform 0.38s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.3s ease-out !important;
    }

    .liquid-modal.show .modal-dialog {
