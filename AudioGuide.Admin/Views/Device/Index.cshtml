    /* 7. POPUP LỊCH SỬ TRUY CẬP VÀ MENU NGANG */
    #userHistoryModal .modal-dialog {
        max-width: 1140px;
    }

    #userHistoryModal .modal-content,
    #userHistoryModal .modal-body,
    #userHistoryModal .table-responsive {
        overflow: visible !important;
    }

    #userHistoryModal .modal-body {
        padding-bottom: 60px !important;
    }

    .btn-range-dropdown-pill {
        padding: 7px 18px !important;
        min-width: 82px;
        justify-content: center;
    }

    .horizontal-range-menu {
        display: none;
        flex-direction: row !important;
        align-items: center;
        gap: 5px;
        padding: 6px 10px !important;
        min-width: max-content !important;
        white-space: nowrap;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.72) 100%) !important;
        backdrop-filter: blur(28px) saturate(190%) !important;
        -webkit-backdrop-filter: blur(28px) saturate(190%) !important;
        border: 1.5px solid rgba(255, 255, 255, 0.95) !important;
        border-radius: 9999px !important;
        box-shadow: 0 14px 36px rgba(15, 23, 42, 0.16), inset 0 2px 4px rgba(255, 255, 255, 1) !important;
        right: 0 !important;
        left: auto !important;
        animation: iosHorizontalExpand 0.28s cubic-bezier(0.32, 0.72, 0, 1) forwards;
    }

        .horizontal-range-menu.show {
            display: flex !important;
        }

    @@keyframes iosHorizontalExpand {
        0% {
            opacity: 0;
            transform: scaleX(0.7) translateX(12px);
        }

        100% {
            opacity: 1;
            transform: scaleX(1) translateX(0);
        }
    }

    .btn-range-mini-pill {
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 700;
        border-radius: 9999px;
        border: 1px solid transparent;
        background: transparent;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

        .btn-range-mini-pill:hover {
            background: rgba(2, 132, 199, 0.12);
            color: #0284c7;
        }

        .btn-range-mini-pill.active {
