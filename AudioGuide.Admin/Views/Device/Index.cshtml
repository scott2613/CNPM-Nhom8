</style>

<div class="container-fluid px-4 py-4">
    <!-- 1. HEADER TRANG -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-controller="Home" asp-action="Index" class="btn-back-bubble text-decoration-none" title="Quay lại Dashboard">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2 text-dark">
                <i class="bi bi-phone text-primary"></i> Quản lý thiết bị truy cập & phiên làm việc
            </h2>
            <p class="text-secondary fs-7 mb-0">Hệ thống giám sát thiết bị du khách, bảo mật truy cập và kiểm soát quyền quét mã.</p>
        </div>
    </div>

    <!-- 2. THẺ THỐNG KÊ TỔNG QUAN -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="liquid-card p-3 d-flex align-items-center">
                <div class="stat-icon-liquid bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-phone-fill"></i>
                </div>
                <div class="ms-3">
                    <span class="text-uppercase text-secondary font-monospace fw-semibold" style="font-size: 11px;">TỔNG THIẾT BỊ</span>
                    <h4 class="fw-bold mb-0 text-dark">@totalDevices</h4>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="liquid-card p-3 d-flex align-items-center">
                <div class="stat-icon-liquid bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div class="ms-3">
                    <span class="text-uppercase text-secondary font-monospace fw-semibold" style="font-size: 11px;">ĐANG HOẠT ĐỘNG</span>
                    <h4 class="fw-bold mb-0 text-success" id="activeDeviceCount">@activeDevices</h4>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="liquid-card p-3 d-flex align-items-center">
                <div class="stat-icon-liquid bg-danger bg-opacity-10 text-danger">
                    <i class="bi bi-slash-circle-fill"></i>
                </div>
                <div class="ms-3">
                    <span class="text-uppercase text-secondary font-monospace fw-semibold" style="font-size: 11px;">ĐANG BỊ CHẶN</span>
                    <h4 class="fw-bold mb-0 text-danger">@blockedDevices</h4>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="liquid-card p-3 d-flex align-items-center">
                <div class="stat-icon-liquid bg-info bg-opacity-10 text-info">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div class="ms-3">
                    <span class="text-uppercase text-secondary font-monospace fw-semibold" style="font-size: 11px;">TỔNG SỰ KIỆN TRUY CẬP</span>
                    <h4 class="fw-bold mb-0 text-dark">@totalScans.ToString("N0")</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. THANH ĐIỀU KHIỂN: TÌM KIẾM + 3 NÚT CHỨC NĂNG -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-stretch align-items-lg-center gap-3 mb-3">
        <div class="search-box-wrapper">
            <i class="bi bi-search search-icon-prefix"></i>
            <input type="text"
                   id="deviceSearchInput"
                   class="search-input-clear"
                   placeholder="VD: Samsung, iPhone, Chrome, Edge, 116.108..."
                   oninput="filterDeviceTable()" />
            <button type="button" id="clearSearchBtn" class="search-clear-btn" onclick="clearDeviceSearch()" title="Xóa từ khóa">
                <i class="bi bi-x"></i>
            </button>
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-lg-end gap-2">
            <button type="button" class="btn-liquid-lens" onclick="openDiagnosticModal()" title="Kiểm tra trạng thái kết nối SQL Server và API">
                <i class="bi bi-activity text-primary fs-6"></i> Trạng Thái Kết Nối
            </button>
            <button type="button" class="btn-liquid-lens" onclick="openUserHistoryModal('24h')" title="Xem nhật ký lượt quét">
                <i class="bi bi-hourglass-split text-info fs-6"></i> Lịch Sử Truy Cập
            </button>
            <button type="button" class="btn-liquid-lens text-nowrap" onclick="syncDevices(this)" title="Tải lại danh sách thiết bị đã ghi nhận">
                <i class="bi bi-arrow-repeat fs-6" id="syncDeviceIcon"></i> Làm Mới Thiết Bị
            </button>
        </div>
    </div>

    <!-- 4. BẢNG DANH SÁCH THIẾT BỊ -->
    <div class="liquid-table-container p-3 p-md-4">
        <div class="table-responsive" style="overflow: visible;">
            <table class="table table-liquid align-middle mb-0" id="deviceMainTable" data-paginate="thiết bị">
                <thead>
                    <tr class="text-uppercase fs-7 text-secondary">
                        <th class="py-3 text-center" style="width: 120px;">Mã Thiết Bị</th>
                        <th class="py-3 text-center" style="width: 160px;">Địa Chỉ IP</th>
                        <th class="py-3">Tên Máy</th>
                        <th class="py-3 text-center">Nền Tảng / HĐH</th>
                        <th class="py-3 text-center">Trình Duyệt</th>
                        <th class="py-3 text-center">Sự Kiện</th>
                        <th class="py-3 text-center">Hoạt Động Cuối</th>
                        <th class="py-3 text-center">Trạng Thái</th>
                        <th class="py-3 text-center" style="width: 100px;">Chỉnh Sửa</th>
                    </tr>
                </thead>
                <tbody>
                    @if (sortedDevices != null && sortedDevices.Any())
                    {
                        foreach (var d in sortedDevices)
                        {
                            // Đổi trạng thái sang Ngoại tuyến ngay khi không có nhịp tim quá 20 giây
                            bool isOnline = d.IsOnline;
                            string formattedLastActive = d.LastActiveAt.AddHours(7).ToString("HH:mm - dd/MM/yyyy");

                            <tr ondblclick="openDetailModal(this)"
                                data-id="@d.Id"
                                data-fingerprint="@d.DeviceFingerprint"
                                data-name="@d.DeviceName"
                                data-ip="@d.IpAddress"
                                data-platform="@d.Platform"
                                data-browser="@d.Browser"
                                data-scans="@d.TotalScans"
                                data-blocked="@d.IsBlocked.ToString().ToLower()"
                                data-online="@isOnline.ToString().ToLower()"
                                data-lastactive="@formattedLastActive"
                                title="Nhấp đúp chuột để xem chi tiết thiết bị">

                                <td class="text-center">
                                    <span class="device-id-pill">#@d.DeviceFingerprint</span>
                                </td>

                                <td class="text-center font-monospace fw-bold text-dark fs-7">
                                    @d.IpAddress
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="device-thumb-liquid">
                                            @if (d.Platform.Contains("iOS", StringComparison.OrdinalIgnoreCase) || d.DeviceName.Contains("iPhone", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="bi bi-apple text-dark"></i>
                                            }
                                            else if (d.Platform.Contains("Android", StringComparison.OrdinalIgnoreCase) || d.DeviceName.Contains("Android", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="bi bi-android2 text-success"></i>
                                            }
                                            else if (d.Platform.Contains("Windows", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="bi bi-windows text-primary"></i>
                                            }
                                            else if (d.Platform.Contains("Mac", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="bi bi-laptop text-dark"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-phone text-secondary"></i>
                                            }
                                        </div>
                                        <span class="fw-bold text-dark fs-6 device-name-cell">@d.DeviceName</span>
                                    </div>
                                </td>

                                <td class="text-center">
                                    <span class="platform-badge-liquid">@d.Platform</span>
                                </td>

                                <td class="text-center">
                                    <span class="browser-badge-liquid">
                                        @if (d.Browser.Contains("Edge", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <i class="bi bi-browser-edge text-primary"></i>
                                        }
                                        else if (d.Browser.Contains("Chrome", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <i class="bi bi-browser-chrome text-warning"></i>
                                        }
                                        else if (d.Browser.Contains("Safari", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <i class="bi bi-compass text-info"></i>
                                        }
                                        else if (d.Browser.Contains("Firefox", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <i class="bi bi-browser-firefox text-danger"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-globe"></i>
                                        }
                                        @d.Browser
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="badge-scan-liquid">@d.TotalScans.ToString("N0")</span>
                                </td>

                                <td class="text-center font-monospace small text-muted">
                                    @formattedLastActive
                                </td>

                                <td class="text-center" data-device-status>
                                    @if (d.IsBlocked)
                                    {
                                        <span class="status-badge-maint">
                                            <i class="bi bi-slash-circle-fill"></i> Đang chặn
                                        </span>
                                    }
                                    else if (isOnline)
                                    {
                                        <span class="status-badge-active">
                                            <i class="bi bi-check-circle-fill"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge-offline">
                                            <i class="bi bi-circle"></i> Ngoại tuyến
                                        </span>
                                    }
                                </td>

                                <td class="text-center" onclick="event.stopPropagation();">
                                    <div class="dropdown d-inline-block">
                                        <button class="btn-lens-gear-circle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Tùy chọn chỉnh sửa">
                                            <i class="bi bi-sliders"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end liquid-dropdown-menu">
                                            <li>
                                                <button type="button" class="liquid-dropdown-item" style="color: #0284c7;" onclick="openDetailFromDropdown(this)">
                                                    <i class="bi bi-eye-fill fs-6"></i> Xem chi tiết thiết bị
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="liquid-dropdown-item" style="color: #d97706;" onclick="toggleBlockDevice(@d.Id)">
                                                    <i class="bi bi-shield-lock fs-6"></i> @(d.IsBlocked ? "Gỡ chặn thiết bị" : "Chặn thiết bị")
                                                </button>
                                            </li>
                                            <li><hr class="dropdown-divider my-1 opacity-25"></li>
                                            <li>
                                                <button type="button" class="liquid-dropdown-item text-danger" onclick="deleteDevice(@d.Id)">
                                                    <i class="bi bi-trash3-fill fs-6"></i> Xóa thiết bị
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted fs-6">@(ViewData["ApiError"] is string ? "Chưa tải được danh sách thiết bị." : "Chưa có thiết bị được ghi nhận. Thiết bị sẽ xuất hiện khi khách truy cập bản đồ.")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

