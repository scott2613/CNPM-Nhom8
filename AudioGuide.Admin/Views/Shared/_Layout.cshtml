@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@* Tiêm IConfiguration để đọc tự động BaseUrl của API từ appsettings.json *@
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    // Đọc URL của API từ cấu hình, chuẩn hóa bỏ dấu gạch chéo cuối nếu có
    string apiBaseUrl = (Configuration["ApiSettings:BaseUrl"] ?? "").TrimEnd('/');
    // Đường dẫn mở trực tiếp tài liệu Swagger API
    string swaggerUrl = $"{apiBaseUrl}/swagger";
    // Xác định Controller và Action hiện tại để kích hoạt class active trên menu điều hướng
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Audio Guide Admin Console</title>

    <!-- Nhúng bộ phông chữ Plus Jakarta Sans từ Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

    <!-- CSS Bootstrap 5, Bootstrap Icons và Style hệ thống -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AudioGuide.Admin.styles.css" asp-append-version="true" />

    <!-- Định nghĩa hiệu ứng kính gương lỏng Liquid Glass toàn cục -->
    <style>
        :root {
            --font-family-base: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --lens-bg: linear-gradient(135deg, rgba(255, 255, 255, 0.65) 0%, rgba(255, 255, 255, 0.22) 50%, rgba(255, 255, 255, 0.1) 60%, rgba(255, 255, 255, 0.45) 100%);
            --lens-border: rgba(255, 255, 255, 0.95);
            --lens-highlight: inset 0 2.5px 4px 0 rgba(255, 255, 255, 1), inset 0 -2.5px 4px 0 rgba(2, 132, 199, 0.18), inset 0 0 16px 0 rgba(255, 255, 255, 0.6);
            --lens-shadow: 0 12px 28px -4px rgba(2, 132, 199, 0.22), 0 4px 12px -2px rgba(15, 23, 42, 0.08);
        }

        * {
            font-family: var(--font-family-base) !important;
            letter-spacing: -0.01em;
        }

        /* Nền toàn trang chuyển màu xanh nhạt và trắng thấu kính */
        body {
            background: var(--admin-page-background) fixed;
            min-height: 100vh;
            color: #0f172a;
        }

        /* Thanh điều hướng Liquid Glass kính mờ */
        .navbar-liquid {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.65) 0%, rgba(255, 255, 255, 0.25) 100%) !important;
            backdrop-filter: blur(28px) saturate(220%) brightness(108%);
            -webkit-backdrop-filter: blur(28px) saturate(220%) brightness(108%);
            border-bottom: 1.5px solid rgba(255, 255, 255, 0.95);
            box-shadow: 0 10px 30px -5px rgba(14, 116, 144, 0.1), inset 0 -1.5px 2px rgba(255, 255, 255, 0.9);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .navbar-brand-liquid {
            color: #0f172a !important;
            font-weight: 800;
            font-size: 1.15rem;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        /* Khung tròn biểu tượng logo dạng thấu kính */
        .brand-icon-bubble {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--lens-bg);
            border: 1.5px solid var(--lens-border);
            box-shadow: var(--lens-shadow), var(--lens-highlight);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #0284c7;
            font-size: 17px;
        }

        /* Nút chuyển tab trên thanh menu */
        .nav-link-liquid {
            color: #334155 !important;
            font-weight: 700;
            font-size: 13.5px;
            padding: 8px 18px !important;
            border-radius: 9999px;
            border: 1.5px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            text-decoration: none;
        }

            .nav-link-liquid:hover {
                color: #0284c7 !important;
                background: linear-gradient(135deg, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.3));
                border-color: rgba(255, 255, 255, 0.95);
                transform: translateY(-1.5px);
                box-shadow: 0 8px 20px -4px rgba(2, 132, 199, 0.15), var(--lens-highlight);
            }

            .nav-link-liquid.active {
                color: #0284c7 !important;
                background: var(--lens-bg);
                backdrop-filter: blur(20px) saturate(240%);
                -webkit-backdrop-filter: blur(20px) saturate(240%);
                border: 1.5px solid var(--lens-border);
                box-shadow: var(--lens-shadow), var(--lens-highlight);
            }

        /* Chân trang kính mờ */
        .footer-liquid {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0.2) 100%);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-top: 1.5px solid rgba(255, 255, 255, 0.9);
            color: #475569;
            box-shadow: 0 -6px 20px rgba(14, 116, 144, 0.05);
        }
    </style>
<script>
window.escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const originalFetch=window.fetch.bind(window);
window.fetch=(input,options={})=>{ const url=new URL(typeof input==='string'?input:input.url,location.href); const method=(options.method||'GET').toUpperCase();
 if(url.origin===location.origin){const headers=new Headers(options.headers);headers.set('Accept','application/json');if(!['GET','HEAD','OPTIONS'].includes(method))headers.set('X-CSRF-TOKEN',document.querySelector('meta[name="csrf-token"]').content);options={...options,headers};}
 return originalFetch(input,options).then(response=>{if(url.origin===location.origin&&response.headers.get('X-Admin-Login-Required')==='1')location.assign('/Account/Login');return response;});};
window.adminJson = async (url, options = {}) => {
    const response = await fetch(url, options);
    if (response.status === 401)
        throw new Error(response.headers.get('X-Admin-Login-Required') === '1'
            ? 'Phiên đăng nhập quản trị đã hết hạn.'
            : 'API từ chối xác thực. Hãy kiểm tra cấu hình kết nối giữa Admin và API.');
    const text = await response.text();
    let data;
    try { data = text ? JSON.parse(text) : {}; }
    catch { throw new Error(`API trả phản hồi không hợp lệ (HTTP ${response.status}).`); }
    if (!response.ok || data?.success === false)
        throw new Error(data?.message || data?.title || `Yêu cầu không thành công (HTTP ${response.status}).`);
    return data;
};
if(window.jQuery)$.ajaxPrefilter((options,original,xhr)=>{if(!/^(GET|HEAD|OPTIONS)$/i.test(options.type))xhr.setRequestHeader('X-CSRF-TOKEN',document.querySelector('meta[name="csrf-token"]').content);});
</script>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md navbar-liquid py-2.5">
            <div class="container-fluid px-4">
                <a class="navbar-brand navbar-brand-liquid" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon-bubble">
                        <i class="bi bi-shield-check"></i>
                    </span>
                    <span>Audio Guide Admin Console</span>
                </a>
                <button class="navbar-toggler border-0 p-1" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto gap-2 mt-2 mt-md-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-liquid @(currentController == "Account" ? "active" : "")" asp-controller="Account" asp-action="Settings">Tài khoản</a>
                        </li>
                        <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-link-liquid bg-transparent" type="submit">Đăng xuất</button></form></li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-liquid @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-broadcast-pin me-1"></i> Dashboard & Quản Lý POI
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-liquid @(currentController == "Device" ? "active" : "")" asp-area="" asp-controller="Device" asp-action="Index">
                                <i class="bi bi-phone me-1"></i> Quản Lý Thiết Bị
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-liquid @(currentController == "User" ? "active" : "")" asp-area="" asp-controller="User" asp-action="Index">
                                <i class="bi bi-activity me-1"></i> Giám Sát Real-time
                            </a>
                        </li>
                        <li class="nav-item">
                            @* Đường dẫn Swagger tự động ăn khớp theo địa chỉ Dev Tunnel *@
                            <a class="nav-link nav-link-liquid" href="@swaggerUrl" target="_blank">
                                <i class="bi bi-code-slash me-1"></i> Swagger API
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 flex-grow-1">
        <main role="main" class="py-3">
            @if(ViewData["ApiError"] is string apiError){<div class="alert alert-warning" role="alert">@apiError</div>}
            @RenderBody()
        </main>
    </div>

    <footer class="footer-liquid py-3 mt-auto">
        <div class="container-fluid px-4 text-center small fw-semibold">
            &copy; 2026 - <strong>Bảng Điều Khiển Quản Trị Audio Guide</strong> - Phiên bản 1.0 (Liquid Glass Edition)
        </div>
    </footer>

    <!-- Thư viện Javascript jQuery và Bootstrap Bundle -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-pagination.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
