<section id="gateChart" class="liquid-table-container p-3 p-md-4 mb-4"
         data-url="@Url.Action("GetGateEntriesByHour", "User")" aria-labelledby="gateChartHeading">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h2 id="gateChartHeading" class="h5 fw-bold mb-1">Lượt khách vào cổng theo giờ</h2>
            <p class="text-secondary small mb-0">Số lượt vào qua mã QR cổng chính, cộng theo giờ Việt Nam (UTC+7).</p>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-2">
            <details id="gateChartRange" class="glass-range-picker">
                <summary class="btn-liquid-lens px-3 py-1" aria-label="Chọn khoảng thống kê lượt vào cổng">
                    <span data-range-label>1 ngày</span><span aria-hidden="true">⌄</span>
                </summary>
                <div class="glass-segments" role="group" aria-label="Khoảng thống kê lượt vào cổng">
                    <button type="button" data-range="1d" aria-pressed="true">1 ngày</button>
                    <button type="button" data-range="7d" aria-pressed="false">7 ngày</button>
                    <button type="button" data-range="30d" aria-pressed="false">30 ngày</button>
                </div>
            </details>
            <button id="gateChartRefresh" type="button" class="btn-liquid-lens px-3 py-1">Làm mới</button>
        </div>
    </div>
    <p id="gateChartStatus" class="small text-secondary mb-2" role="status">Đang tải thống kê…</p>
    <div id="gateChartData" hidden>
        <p id="gateChartSummary" class="fw-semibold small mb-2"></p>
        <div class="overflow-auto">
            <ol id="gateChartBars" class="gate-chart-bars list-unstyled mb-0" aria-label="Số lượt vào cổng trong 24 khung giờ"></ol>
        </div>
    </div>
</section>

<section id="poiChart" class="liquid-table-container p-3 p-md-4 mb-4"
         data-url="@Url.Action("GetPoiInteractions", "User")" aria-labelledby="poiChartHeading">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h2 id="poiChartHeading" class="h5 fw-bold mb-1">Lượt truy cập và nghe theo địa điểm</h2>
            <p class="text-secondary small mb-0">So sánh lượt mở điểm trên bản đồ với lượt bắt đầu nghe, theo giờ Việt Nam (UTC+7).</p>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-2">
            <details id="poiChartRange" class="glass-range-picker">
                <summary class="btn-liquid-lens px-3 py-1" aria-label="Chọn khoảng thống kê địa điểm">
                    <span data-range-label>1 ngày</span><span aria-hidden="true">⌄</span>
                </summary>
                <div class="glass-segments" role="group" aria-label="Khoảng thống kê địa điểm">
                    <button type="button" data-range="1d" aria-pressed="true">1 ngày</button>
                    <button type="button" data-range="7d" aria-pressed="false">7 ngày</button>
                    <button type="button" data-range="30d" aria-pressed="false">30 ngày</button>
                </div>
            </details>
            <label for="poiChartLocation" class="visually-hidden">Địa điểm</label>
            <select id="poiChartLocation" class="form-select form-select-sm w-auto glass-chart-select" style="max-width: 14rem" disabled>
                <option value="">Tất cả địa điểm</option>
            </select>
            <button id="poiChartRefresh" type="button" class="btn-liquid-lens px-3 py-1">Làm mới</button>
        </div>
    </div>
    <p id="poiChartStatus" class="small text-secondary mb-2" role="status">Đang tải thống kê…</p>
    <div id="poiChartData" hidden>
        <p id="poiChartPeriod" class="small text-secondary mb-1"></p>
        <p id="poiChartSummary" class="fw-semibold small mb-2" aria-live="polite"></p>
        <div class="d-flex flex-wrap gap-3 small mb-2">
            <span><span class="badge bg-primary" aria-hidden="true">&nbsp;</span> Mở điểm</span>
            <span><span class="badge bg-success" aria-hidden="true">&nbsp;</span> Bắt đầu nghe</span>
        </div>
        <div class="overflow-auto">
            <ul id="poiChartBars" class="poi-chart-bars list-unstyled mb-0" aria-label="Thống kê theo địa điểm"></ul>
        </div>
    </div>
</section>

<script src="~/js/dashboard-chart-controls.js" asp-append-version="true" defer></script>
<script src="~/js/gate-entry-chart.js" asp-append-version="true" defer></script>
<script src="~/js/poi-interactions-chart.js" asp-append-version="true" defer></script>
