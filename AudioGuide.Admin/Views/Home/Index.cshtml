    <!-- 1. HEADER TRANG GỌN GÀNG -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <button type="button" class="btn-back-bubble" onclick="window.history.back()" title="Quay lại trang trước">
            <i class="bi bi-arrow-left"></i>
        </button>
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2 text-dark">
                <i class="bi bi-broadcast text-primary"></i> Quản lý Thuyết minh tự động đa ngôn ngữ
            </h2>
            <p class="text-secondary fs-7 mb-0">Hệ thống điều phối điểm tham quan, âm thanh thuyết minh đa ngữ và phân tích lượt khách.</p>
        </div>
    </div>

    <!-- 2. THẺ THỐNG KÊ TỔNG QUAN -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="liquid-card p-3 d-flex align-items-center">
                <div class="stat-icon-liquid bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div class="ms-3">
                    <span class="text-uppercase text-secondary font-monospace fw-semibold" style="font-size: 11px;">TỔNG ĐIỂM (POI)</span>
                    <h4 class="fw-bold mb-0 text-dark">@(Model?.Count() ?? 0)</h4>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="liquid-card p-3 d-flex align-items-center">
                <div class="stat-icon-liquid bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div class="ms-3">
                    <span class="text-uppercase text-secondary font-monospace fw-semibold" style="font-size: 11px;">ĐANG HOẠT ĐỘNG</span>
                    <h4 class="fw-bold mb-0 text-success">@(Model?.Count(p => p.IsActive) ?? 0)</h4>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="liquid-card p-3 d-flex align-items-center">
                <div class="stat-icon-liquid bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-tools"></i>
                </div>
                <div class="ms-3">
                    <span class="text-uppercase text-secondary font-monospace fw-semibold" style="font-size: 11px;">ĐANG BẢO TRÌ</span>
                    <h4 class="fw-bold mb-0 text-warning">@(Model?.Count(p => !p.IsActive) ?? 0)</h4>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="liquid-card p-3 d-flex align-items-center">
                <div class="stat-icon-liquid bg-info bg-opacity-10 text-info">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div class="ms-3">
                    <span class="text-uppercase text-secondary font-monospace fw-semibold" style="font-size: 11px;">TỔNG LƯỢT TRUY CẬP</span>
                    <h4 class="fw-bold mb-0 text-dark">@totalScans.ToString("N0")</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. THANH ĐIỀU KHIỂN: Ô TÌM KIẾM BÊN TRÁI + NÚT CHỨC NĂNG BÊN PHẢI -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-stretch align-items-lg-center gap-3 mb-3">
        <!-- Ô TÌM KIẾM ĐẬM CHỮ, RÕ KÝ HIỆU -->
        <div class="search-box-wrapper">
            <i class="bi bi-search search-icon-prefix"></i>
            <input type="text"
                   id="poiSearchInput"
                   class="search-input-clear"
                   placeholder="VD: Máy bay chiến đấu, POI-01, Tầng 1..."
                   oninput="filterPoiTable()" />
            <button type="button" id="clearSearchBtn" class="search-clear-btn" onclick="clearPoiSearch()" title="Xóa từ khóa">
                <i class="bi bi-x"></i>
            </button>
        </div>

        <!-- CỤM 3 NÚT CHỨC NĂNG BÊN PHẢI -->
        <div class="d-flex flex-wrap align-items-center justify-content-lg-end gap-2">
            <a class="btn-liquid-lens" href="#poiChart">
                <i class="bi bi-bar-chart-fill text-primary fs-6" aria-hidden="true"></i> Thống kê địa điểm
            </a>
            <button type="button" class="btn-liquid-lens" onclick="openDiagnosticModal()" title="Kiểm tra trạng thái kết nối SQL Server và API">
                <i class="bi bi-activity text-primary fs-6"></i> Trạng Thái Kết Nối
            </button>
            <button type="button" class="btn-liquid-lens" onclick="openCreatePoiModal()">
                <i class="bi bi-plus-circle-fill text-success fs-6"></i> Thêm Điểm Mới
            </button>
            <button type="button" class="btn-liquid-lens text-nowrap" onclick="refreshWholeSystem(this)" title="Làm mới danh mục">
                <i class="bi bi-arrow-repeat fs-6" id="refreshSystemIcon"></i> Cập Nhật Hệ Thống
            </button>
        </div>
    </div>

    <!-- 4. BẢNG DANH SÁCH ĐỊA ĐIỂM -->
    <div class="liquid-table-container p-3 p-md-4">
        <div class="table-responsive" style="overflow: visible;">
            <table class="table table-liquid align-middle" id="poiMainTable" data-paginate="điểm tham quan">
                <thead>
                    <tr class="text-uppercase fs-7 text-secondary">
                        <th class="py-3 text-center" style="width: 110px;">Mã / STT</th>
                        <th class="py-3">Địa Điểm Thuyết Minh</th>
                        <th class="py-3 text-center">Tầng</th>
                        <th class="py-3 text-center">Tọa Độ GPS</th>
                        <th class="py-3 text-center">Lượt Nghe</th>
                        <th class="py-3 text-center">Trạng Thái</th>
                        <th class="py-3 text-center" style="width: 110px;">Chỉnh Sửa</th>
                    </tr>
                </thead>
                <tbody>
                    @if (sortedPois != null && sortedPois.Any())
                    {
                        foreach (var poi in sortedPois)
                        {
                            string invLat = poi.Lat.ToString(CultureInfo.InvariantCulture);
                            string invLng = poi.Lng.ToString(CultureInfo.InvariantCulture);

                            <tr ondblclick="openDetailModal(this)"
                                data-id="@poi.Id" data-version="@poi.RowVersion" data-radius="@poi.TriggerRadiusMeters"
                                data-code="@poi.Code"
                                data-title="@poi.TitleVi"
                                data-floor="@poi.Floor"
                                data-lat="@invLat"
                                data-lng="@invLng"
                                data-desc="@poi.DescVi"
                                data-image="@poi.ImageUrl"
                                data-scans="@poi.ScanCount"
                                data-active="@poi.IsActive.ToString().ToLower()"
                                title="Nhấp đúp chuột để xem chi tiết">

                                <td class="text-center">
                                    <span class="poi-id-pill">#@poi.Code</span>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(poi.ImageUrl))
                                        {
                                            <img src="@poi.ImageUrl" alt="@poi.TitleVi" class="poi-thumb-liquid" onerror="this.src='https://placehold.co/100x100?text=Di+Tích';" />
                                        }
                                        else
                                        {
                                            <div class="poi-thumb-liquid bg-white bg-opacity-60 d-flex align-items-center justify-content-center text-muted fs-5">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                        <div class="fw-bold text-dark fs-6 poi-title-cell">@poi.TitleVi</div>
                                    </div>
                                </td>

                                <td class="text-center">
                                    @if (poi.Floor == 0)
                                    {
                                        <span class="floor-badge-liquid">🏛️ Trệt (G)</span>
                                    }
                                    else
                                    {
                                        <span class="floor-badge-liquid">🏢 Tầng @poi.Floor</span>
                                    }
                                </td>

                                <td class="text-center font-monospace fs-7 text-muted">
                                    <a href="https://maps.google.com/?q=@invLat,@invLng" target="_blank" onclick="event.stopPropagation();" class="text-decoration-none text-muted" title="Mở trên Google Maps">
                                        📍 @poi.Lat.ToString("F4"), @poi.Lng.ToString("F4")
                                    </a>
                                </td>

                                <td class="text-center">
                                    <span class="badge-scan-liquid">@poi.ScanCount.ToString("N0")</span>
                                </td>

                                <td class="text-center">
                                    @if (poi.IsActive)
                                    {
                                        <span class="status-badge-active">
                                            <i class="bi bi-check-circle-fill"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge-maint">
                                            <i class="bi bi-tools"></i> Bảo trì
                                        </span>
                                    }
                                </td>

                                <td class="text-center" onclick="event.stopPropagation();">
                                    <div class="dropdown d-inline-block">
                                        <button class="btn-lens-gear-circle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Tùy chọn chỉnh sửa">
                                            <i class="bi bi-sliders"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end liquid-dropdown-menu">
                                            <li>
                                                <button type="button" class="liquid-dropdown-item text-primary fw-bold" onclick="previewFromRow(this)">
                                                    <i class="bi bi-broadcast fs-6"></i> Truy cập thử
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="liquid-dropdown-item" style="color: #0284c7;" onclick="openDetailFromDropdown(this)">
                                                    <i class="bi bi-eye-fill fs-6"></i> Xem chi tiết & Bản đồ
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="liquid-dropdown-item" style="color: #475569;" onclick="openEditFromDropdown(this)">
                                                    <i class="bi bi-pencil-square fs-6"></i> Sửa thông tin
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="liquid-dropdown-item" style="color: #d97706;" onclick="togglePoiStatus(@poi.Id)">
                                                    <i class="bi bi-arrow-repeat fs-6"></i> Trạng thái: @(poi.IsActive ? "Chuyển Bảo trì" : "Kích hoạt")
                                                </button>
                                            </li>
                                            <li><hr class="dropdown-divider my-1 opacity-25"></li>
                                            <li>
                                                <button type="button" class="liquid-dropdown-item text-danger" onclick="deletePoi(@poi.Id)">
                                                    <i class="bi bi-trash3-fill fs-6"></i> Xóa địa điểm
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted fs-6">@(ViewData["ApiError"] is string ? "Chưa tải được danh sách điểm tham quan." : "Chưa có điểm tham quan.")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-4" aria-label="Biểu đồ thống kê">
        <partial name="_DashboardCharts" />
    </div>
</div>

<!-- 1. POPUP CHI TIẾT ĐỊA ĐIỂM -->
<div class="modal fade liquid-modal" id="poiDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header border-bottom border-light-subtle p-4">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn-back-bubble" data-bs-dismiss="modal" title="Quay lại">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        <span class="poi-id-pill fs-6" id="detailPoiCode">#1</span>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="detailPoiTitle">Tên Điểm Thuyết Minh</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <div class="col-md-5">
                        <div class="position-relative">
                            <img id="detailPoiImage" src="" alt="Hiện vật"
                                 class="w-100 shadow-sm clickable-zoom-img"
                                 style="height: 220px; object-fit: cover; border-radius: 24px; border: 1.5px solid rgba(255,255,255,0.95);"
                                 onclick="openLightboxFromDetail()"
                                 title="Nhấp vào để phóng to xem toàn bộ ảnh">
                            <span class="position-absolute bottom-0 end-0 m-2 badge bg-dark bg-opacity-60 text-white rounded-pill px-2.5 py-1 font-monospace" style="font-size: 10px; backdrop-filter: blur(8px);">
                                🔍 Xem toàn ảnh
                            </span>
                        </div>

                        <div class="mt-3 p-3 bg-white bg-opacity-40 border shadow-sm" style="border-radius: 20px;">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary small">Vị trí tầng:</span>
                                <span class="fw-bold text-dark small" id="detailPoiFloor">Tầng Trệt</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary small">Trạng thái:</span>
                                <span class="fw-bold small" id="detailPoiStatus">Hoạt động</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-secondary small">Lượt truy cập:</span>
                                <span class="fw-bold text-primary small" id="detailPoiScans">0 lượt</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <h6 class="fw-bold text-secondary text-uppercase small mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Vị Trí Bản Đồ Vệ Tinh Trực Tiếp:</h6>
                        <div class="border shadow-sm mb-3" style="border-radius: 20px; overflow: hidden;">
                            <iframe id="detailMapFrame" src="" width="100%" height="190" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                        </div>
                        <h6 class="fw-bold text-secondary text-uppercase small mb-1"><i class="bi bi-card-text text-primary me-1"></i>NỘI DUNG THUYẾT MINH (30S):</h6>
                        <p class="text-dark small bg-white bg-opacity-40 p-3 border mb-0" id="detailPoiDesc" style="line-height: 1.6; max-height: 130px; overflow-y: auto; border-radius: 20px;">
                            Chưa có nội dung.
                        </p>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top-0 pt-0 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn-liquid-lens text-primary" onclick="testScanFromDetail()" title="Nghe thử âm thanh thuyết minh điểm này">
                        <i class="bi bi-volume-up-fill fs-6"></i> Nghe thử
                    </button>
                    <button type="button" class="btn-liquid-lens text-secondary" onclick="editPoiFromDetail()" title="Chỉnh sửa thông tin địa điểm này">
                        <i class="bi bi-pencil-square fs-6"></i> Sửa
                    </button>
                    <button type="button" class="btn-liquid-lens text-danger" onclick="deletePoiFromDetail()" title="Xóa địa điểm này">
                        <i class="bi bi-trash3-fill fs-6"></i> Xóa
                    </button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a id="detailExternalMapBtn" href="#" target="_blank" class="btn-liquid-lens small" style="color: #0284c7;">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Google Maps
                    </a>
                    <button type="button" class="btn-liquid-lens" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. MODAL PHÓNG TO ẢNH TOÀN MÀN HÌNH -->
<div class="modal fade liquid-modal" id="imageLightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 bg-transparent shadow-none align-items-center">
            <div class="position-relative d-inline-block">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 z-3 bg-dark bg-opacity-50 p-2.5 rounded-circle" data-bs-dismiss="modal" aria-label="Close"></button>
                <img id="lightboxImageTarget" src="" class="img-fluid rounded-4 shadow-lg border border-2 border-white" style="max-height: 82vh; object-fit: contain;">
            </div>
            <h6 id="lightboxTitleCaption" class="text-white text-center mt-3 font-monospace px-3 py-1.5 rounded-pill bg-dark bg-opacity-50 border border-white border-opacity-25 small mb-0">
                Hình ảnh hiện vật
            </h6>
        </div>
    </div>
</div>

<!-- 3. MODAL THÊM / CHỈNH SỬA POI -->
<div class="modal fade liquid-modal" id="poiModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header border-bottom-0 p-4 pb-0">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn-back-bubble" data-bs-dismiss="modal" title="Quay lại">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <h5 class="modal-title fw-bold text-dark fs-5 mb-0" id="poiModalTitle">
                        <i class="bi bi-plus-circle-fill text-primary me-2"></i>Thêm Điểm Thuyết Minh Mới
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="poiForm" onsubmit="savePoiToDb(event)">
                    <input type="hidden" id="poiId" value="0" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold text-secondary fs-7 mb-1">
                                <i class="bi bi-hash me-1"></i>MÃ SỐ (STT)
                            </label>
                            <input type="text" class="form-control form-control-glass font-monospace shadow-sm" id="poiCode" placeholder="VD: 1 hoặc POI-01" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold text-secondary fs-7 mb-1">
                                <i class="bi bi-layers-half me-1"></i>VỊ TRÍ TẦNG
                            </label>
                            <select class="form-select form-control-glass shadow-sm" id="poiFloor">
                                <option value="0">Tầng Trệt (G)</option>
                                <option value="1">Tầng 1</option>
                                <option value="2">Tầng 2</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold text-secondary fs-7 mb-1">
                                <i class="bi bi-graph-up-arrow me-1"></i>LƯỢT TRUY CẬP
                            </label>
                            <input type="number" min="0" class="form-control form-control-glass font-monospace shadow-sm" id="poiScanCount" readonly title="Số liệu chỉ đọc, được tính từ các lượt phát thực tế" placeholder="0" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold text-secondary fs-7 mb-1">
                                <i class="bi bi-toggle2-on me-1"></i>TRẠNG THÁI
                            </label>
                            <select class="form-select form-control-glass shadow-sm" id="poiIsActive">
                                <option value="true">🟢 Hoạt động</option>
                                <option value="false">🟡 Bảo trì</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary fs-7 mb-1">
                            <i class="bi bi-tag-fill me-1"></i>TÊN ĐIỂM THAM QUAN (TIẾNG VIỆT)
                        </label>
                        <input type="text" class="form-control form-control-glass shadow-sm" id="poiTitleVi" placeholder="VD: Sân trưng bày hiện vật ngoài trời" required>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary fs-7 mb-1">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>VĨ ĐỘ (LATITUDE)
                            </label>
                            <input type="number" step="any" class="form-control form-control-glass font-monospace shadow-sm" id="poiLat" placeholder="VD: 10.779250" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary fs-7 mb-1">
                                <i class="bi bi-geo-alt-fill text-primary me-1"></i>KINH ĐỘ (LONGITUDE)
                            </label>
                            <input type="number" step="any" class="form-control form-control-glass font-monospace shadow-sm" id="poiLng" placeholder="VD: 106.692250" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary fs-7 mb-1">
                            <i class="bi bi-image-fill me-1"></i>HÌNH ẢNH HIỆN VẬT (IMAGE URL)
                        </label>
                        <div class="d-flex gap-2">
                            <input type="text" class="form-control form-control-glass shadow-sm flex-grow-1" id="poiImageUrl"
                                   placeholder="VD: https://... hoặc /images/wrm/ten-anh.jpg"
                                   oninput="previewModalImage(this.value)">
                            <button class="btn-liquid-lens px-3 py-1" type="button" onclick="clearModalImage()">
                                <i class="bi bi-x-lg me-1"></i>Xóa
                            </button>
                        </div>
                        <div id="modalImagePreviewBox" class="mt-2 p-2 border bg-white bg-opacity-40 d-none align-items-center gap-3" style="border-radius: 20px;">
                            <img id="modalImagePreviewTarget" src="" alt="Xem trước ảnh" style="width: 60px; height: 60px; object-fit: cover; border-radius: 14px;" onerror="this.src='https://placehold.co/100x100?text=Lỗi+Ảnh';" />
                            <div class="small">
                                <span class="text-success fw-bold d-block"><i class="bi bi-check-circle-fill me-1"></i>Ảnh hợp lệ</span>
                                <span class="text-muted" style="font-size: 11px;">Ảnh này sẽ hiển thị trên bản đồ số và thuyết minh du khách.</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary fs-7 mb-1">
                            <i class="bi bi-card-text me-1"></i>NỘI DUNG VĂN BẢN ĐỌC THUYẾT MINH
                        </label>
                        <textarea class="form-control form-control-glass shadow-sm" id="poiDescVi" rows="4" placeholder="Nhập văn bản để hệ thống chuyển thành giọng đọc..."></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top border-light-subtle">
                        <button type="button" class="btn-liquid-lens" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i>Hủy
                        </button>
                        <button type="submit" class="btn-liquid-lens" style="color: #0284c7;">
                            <i class="bi bi-floppy2-fill me-1"></i>Lưu Vào CSDL
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- 4. MODAL CHẨN ĐOÁN KẾT NỐI -->
<div class="modal fade liquid-modal" id="adminDiagnosticModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 p-3">
            <div class="modal-header border-bottom border-light-subtle pb-3">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn-back-bubble" data-bs-dismiss="modal" title="Quay lại">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2 mb-0">
                        <span class="p-2 rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex">
                            <i class="bi bi-hdd-network"></i>
                        </span>
                        Chẩn Đoán Kết Nối SQL Server & API
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body py-3">
                <div id="diagLoadingAdmin" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-secondary small mt-2">Đang truy vấn trực tiếp CSDL SQL Server...</p>
                </div>

                <div id="diagResultAdmin" class="d-none">
                    <div class="p-3 mb-3 rounded-4 border bg-white bg-opacity-60 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark small"><i class="bi bi-database-fill text-primary me-1"></i>SQL Server:</span>
                            <span id="diagDbBadgeAdmin" class="badge rounded-pill px-3 py-1.5 font-monospace">Kiểm tra...</span>
                        </div>
                        <div class="small text-secondary font-monospace" style="font-size: 11.5px; line-height: 1.65;">
                            <div>• Máy chủ: <b class="text-dark" id="diagDbServerAdmin">-</b></div>
                            <div>• Database: <b class="text-dark" id="diagDbNameAdmin">-</b></div>
                            <div>• Số POI thực tế trong DB: <b class="text-primary fs-6" id="diagDbPoiCountAdmin">Chưa kiểm tra</b></div>
                            <div>• Độ trễ truy vấn: <b class="text-success" id="diagDbPingAdmin">0 ms</b></div>
                        </div>
                        <div id="diagDbErrorBoxAdmin" class="alert alert-danger p-2 mt-2 small d-none" style="font-size: 11px;"></div>
                    </div>

                    <div class="p-3 rounded-4 border bg-white bg-opacity-60 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark small"><i class="bi bi-cpu-fill text-info me-1"></i>Máy Chủ API:</span>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-3 py-1.5" id="diagApiBadgeHome">Đang kiểm tra</span>
                        </div>
                        <div class="small text-secondary font-monospace" style="font-size: 11.5px; line-height: 1.65;">
                            <div>• Host đang chạy: <b class="text-dark" id="diagApiHostAdmin">-</b></div>
                            <div>• Lần kiểm tra cuối: <b class="text-dark" id="diagTimestampAdmin">-</b></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top-0 pt-0 d-flex justify-content-between">
                <small class="text-muted" style="font-size: 11px;">💡 Đối chiếu với bảng [Pois] trong SSMS.</small>
                <button type="button" class="btn-liquid-lens nav-link-diag py-1.5 px-3" onclick="fetchDiagnosticDataAdmin()">
                    <i class="bi bi-arrow-clockwise"></i> Thử lại
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let poiModalInstance, detailModalInstance, diagnosticModalAdminInstance, imageLightboxInstance;
    let currentActiveRow = null;

    /* DỮ LIỆU ĐIỀU KHIỂN TRÌNH PHÁT ÂM THANH ADMIN */
    let currentAudioRate = 1.0;
    let playerProgressInterval = null;
    let playerCurrentSec = 0;
    let playerTotalSec = 21;
    let isPlaying = false;
    let isMuted = false;

    document.addEventListener("DOMContentLoaded", function () {
        poiModalInstance = new bootstrap.Modal(document.getElementById('poiModal'));
        detailModalInstance = new bootstrap.Modal(document.getElementById('poiDetailModal'));
        diagnosticModalAdminInstance = new bootstrap.Modal(document.getElementById('adminDiagnosticModal'));
        imageLightboxInstance = new bootstrap.Modal(document.getElementById('imageLightboxModal'));
    });

    // Hàm gọi API đồng bộ, xử lý parse JSON an toàn
    function apiFetch(url, options = {}) {
        return adminJson(url, options);
    }

    // LỌC BẢNG THEO TÊN, MÃ POI HOẶC TẦNG
    function filterPoiTable() {
        const searchEl = document.getElementById("poiSearchInput");
        const clearBtn = document.getElementById("clearSearchBtn");
        const input = searchEl.value.toLowerCase().trim();

        if (clearBtn) {
            clearBtn.style.display = input.length > 0 ? "inline-flex" : "none";
        }

        const rows = document.querySelectorAll("#poiMainTable tbody tr");
        rows.forEach(row => {
            const code = (row.getAttribute("data-code") || "").toLowerCase();
            const title = (row.getAttribute("data-title") || "").toLowerCase();
            const floor = (row.getAttribute("data-floor") || "").toLowerCase();
            const floorLabel = floor === "0" ? "trệt (g) tầng 0" : `tầng ${floor}`;

            if (!input || code.includes(input) || title.includes(input) || floorLabel.includes(input)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
        window.refreshAdminPagination?.("poiMainTable", true);
    }

    function clearPoiSearch() {
        const searchEl = document.getElementById("poiSearchInput");
        searchEl.value = "";
        filterPoiTable();
        searchEl.focus();
    }

    // ĐỒNG BỘ TOÀN BỘ CƠ SỞ DỮ LIỆU
    function refreshWholeSystem(btn) {
        const icon = document.getElementById('refreshSystemIcon');
        if (icon) icon.classList.add('spin-fast');
        btn.style.pointerEvents = 'none';
        btn.style.opacity = '0.75';

        apiFetch('/Home/SyncSystem', { method: 'POST' })
            .then(data => {
                alert("✓ " + (data.message || "Đã hoàn tất đồng bộ hệ thống!"));
                location.reload();
            })
            .catch(err => {
                alert("Lỗi đồng bộ: " + err.message);
                location.reload();
            });
    }

    function openDiagnosticModal() {
        diagnosticModalAdminInstance.show();
        fetchDiagnosticDataAdmin();
    }

    // TRUY VẤN SỨC KHỎE KẾT NỐI SQL SERVER & API
    function fetchDiagnosticDataAdmin() {
        const loading = document.getElementById('diagLoadingAdmin');
        const result = document.getElementById('diagResultAdmin');
        loading.classList.remove('d-none');
        result.classList.add('d-none');

        apiFetch('/Home/CheckHealth')
            .then(data => {
                const apiBadge = document.getElementById('diagApiBadgeHome');
                apiBadge.className = 'badge bg-success';
                apiBadge.textContent = 'Online';
                loading.classList.add('d-none');
                result.classList.remove('d-none');

                const isDbOk = data.database && data.database.status === 'Connected';
                const dbBadge = document.getElementById('diagDbBadgeAdmin');
                dbBadge.className = isDbOk
                    ? 'badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-3 py-1.5'
                    : 'badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-3 py-1.5';
                dbBadge.innerText = isDbOk ? 'Đã kết nối và truy vấn' :
                    data.database?.status === 'QueryFailed' ? 'SQL cần kiểm tra' : 'Chưa kết nối SQL';

                document.getElementById('diagDbServerAdmin').innerText = data.database?.server || 'N/A';
                document.getElementById('diagDbNameAdmin').innerText = data.database?.database || 'N/A';
                document.getElementById('diagDbPoiCountAdmin').innerText = Number.isInteger(data.database?.currentPoiCount) ? data.database.currentPoiCount + ' địa điểm' : 'Chưa đọc được';
                document.getElementById('diagDbPingAdmin').innerText = (data.database?.responseTimeMs ?? 0) + ' ms';

                const errBox = document.getElementById('diagDbErrorBoxAdmin');
                if (data.database?.error) {
                    errBox.innerText = data.database.error;
                    errBox.classList.remove('d-none');
                } else {
                    errBox.classList.add('d-none');
                }

                document.getElementById('diagApiHostAdmin').innerText = (data.api?.scheme || 'http') + '://' + (data.api?.host || 'localhost');
                document.getElementById('diagTimestampAdmin').innerText = data.timestamp || new Date().toLocaleTimeString();
            })
            .catch(err => {
                const apiBadge = document.getElementById('diagApiBadgeHome');
                apiBadge.className = 'badge bg-secondary';
                apiBadge.textContent = 'Chưa xác định';
                document.getElementById('diagApiHostAdmin').textContent = '—';
                document.getElementById('diagTimestampAdmin').textContent = '—';
                document.getElementById('diagDbPoiCountAdmin').textContent = 'Chưa đọc được';
                document.getElementById('diagDbServerAdmin').textContent = '—';
                document.getElementById('diagDbNameAdmin').textContent = '—';
                document.getElementById('diagDbPingAdmin').textContent = '—';
                loading.classList.add('d-none');
                result.classList.remove('d-none');
                const dbBadge = document.getElementById('diagDbBadgeAdmin');
                dbBadge.className = 'badge bg-danger text-white rounded-pill px-3 py-1.5';
                dbBadge.innerText = 'Chưa kiểm tra SQL';
                const errBox = document.getElementById('diagDbErrorBoxAdmin');
                errBox.innerText = err.message;
                errBox.classList.remove('d-none');
            });
    }

    // HIỂN THỊ MODAL CHI TIẾT ĐỊA ĐIỂM
    function openDetailModal(row) {
        currentActiveRow = row;
        const code = row.getAttribute('data-code');
        const title = row.getAttribute('data-title');
        const floor = row.getAttribute('data-floor') === '0' ? 'Tầng Trệt (G)' : 'Tầng ' + row.getAttribute('data-floor');
        const lat = row.getAttribute('data-lat');
        const lng = row.getAttribute('data-lng');
        const desc = row.getAttribute('data-desc');
        const image = row.getAttribute('data-image') || 'https://placehold.co/400x300?text=Di+Tich';
        const scans = row.getAttribute('data-scans');
        const isActive = row.getAttribute('data-active') === 'true';

        document.getElementById('detailPoiCode').innerText = '#' + code;
        document.getElementById('detailPoiTitle').innerText = title;
        document.getElementById('detailPoiFloor').innerText = floor;
        document.getElementById('detailPoiDesc').innerText = desc || 'Chưa có nội dung thuyết minh.';
        document.getElementById('detailPoiImage').src = image;
        document.getElementById('detailPoiScans').innerText = scans + ' lượt';

        const statusEl = document.getElementById('detailPoiStatus');
        statusEl.innerHTML = isActive
            ? '<span class="status-badge-active"><i class="bi bi-check-circle-fill"></i> Hoạt động</span>'
            : '<span class="status-badge-maint"><i class="bi bi-tools"></i> Bảo trì</span>';

        document.getElementById('detailMapFrame').src = `https://maps.google.com/maps?q=${lat},${lng}&hl=vi&z=19&output=embed`;
        document.getElementById('detailExternalMapBtn').href = `https://maps.google.com/?q=${lat},${lng}`;

        detailModalInstance.show();
    }

    function openDetailFromDropdown(btn) {
        const row = btn.closest('tr');
        if (row) openDetailModal(row);
    }

    function openEditFromDropdown(btn) {
        const row = btn.closest('tr');
        if (row) openEditPoiModalFromRow(row);
    }

    // LOGIC PHÁT THỬ ÂM THANH TRÊN MÀN HÌNH ADMIN (KHÔNG GHI NHẬN TĂNG LƯỢT QUÉT)
    function testScanPoi(code, title = "", desc = "") {
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
        }

        const cleanCode = (code || '').toString().replace(/^#/, '');
        const poiTitleText = title || (currentActiveRow ? currentActiveRow.getAttribute('data-title') : 'Điểm #' + cleanCode);
        const poiDescText = desc || (currentActiveRow ? currentActiveRow.getAttribute('data-desc') : 'Nội dung thuyết minh điểm tham quan.');

        document.getElementById('playerPoiTitle').innerText = poiTitleText;
        playerTotalSec = Math.max(12, Math.min(60, Math.round(poiDescText.length / 5)));
        playerCurrentSec = 0;

        document.getElementById('playerDurationTime').innerText = formatMmSs(playerTotalSec);
        document.getElementById('playerCurrentTime').innerText = "00:00";
        document.getElementById('playerSeeker').value = 0;

        const widget = document.getElementById('adminAudioPlayerWidget');
        widget.classList.remove('d-none');

        isPlaying = true;
        updatePlayPauseUI();

        if ('speechSynthesis' in window && poiDescText) {
            const utter = new SpeechSynthesisUtterance(poiDescText);
            utter.lang = 'vi-VN';
            utter.rate = currentAudioRate;

            utter.onend = function () {
                closeAdminAudioPlayer();
            };

            window.speechSynthesis.speak(utter);
        }

        clearInterval(playerProgressInterval);
        playerProgressInterval = setInterval(() => {
            if (isPlaying) {
                playerCurrentSec++;
                document.getElementById('playerCurrentTime').innerText = formatMmSs(playerCurrentSec);
                let pct = Math.round((playerCurrentSec / playerTotalSec) * 100);
                document.getElementById('playerSeeker').value = pct;

                if (playerCurrentSec >= playerTotalSec) {
                    clearInterval(playerProgressInterval);
                    closeAdminAudioPlayer();
                }
            }
        }, 1000);
    }

    function testScanFromDetail() {
        if (!currentActiveRow) return;
        const code = currentActiveRow.getAttribute('data-code');
        const title = currentActiveRow.getAttribute('data-title');
        const desc = currentActiveRow.getAttribute('data-desc');
        testScanPoi(code, title, desc);
    }

    function formatMmSs(sec) {
        let m = Math.floor(sec / 60);
        let s = Math.floor(sec % 60);
        return (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
    }

    function toggleAudioPlayPause() {
        isPlaying = !isPlaying;
        updatePlayPauseUI();

        if ('speechSynthesis' in window) {
            if (isPlaying) window.speechSynthesis.resume();
            else window.speechSynthesis.pause();
        }
    }

    function updatePlayPauseUI() {
        const icon = document.getElementById('playerPlayIcon');
        if (isPlaying) {
            icon.className = 'bi bi-pause-fill fs-4 text-white';
        } else {
            icon.className = 'bi bi-play-fill fs-4 text-white';
        }
    }

    function onAudioSeek(val) {
        playerCurrentSec = Math.round((val / 100) * playerTotalSec);
        document.getElementById('playerCurrentTime').innerText = formatMmSs(playerCurrentSec);
    }

    function onVolumeChange(val) {
        const icon = document.getElementById('playerVolumeIcon');
        if (val == 0) {
            icon.className = 'bi bi-volume-mute-fill fs-6 text-danger';
            icon.style.color = '';
            isMuted = true;
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();
        } else {
            icon.className = 'bi bi-volume-up-fill fs-6';
            icon.style.color = '#38bdf8';
            isMuted = false;
        }
    }

    function setAudioSpeed(speed) {
        currentAudioRate = speed;
        document.getElementById('speedLabel').innerHTML = speed.toFixed(1) + 'x <span style="font-size: 9px; margin-left: 2px;">▼</span>';
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
            testScanFromDetail();
        }
    }

    function toggleAudioMute() {
        isMuted = !isMuted;
        const icon = document.getElementById('playerVolumeIcon');
        const slider = document.getElementById('playerVolumeSlider');
        if (isMuted) {
            icon.className = 'bi bi-volume-mute-fill fs-6 text-danger';
            icon.style.color = '';
            if (slider) slider.value = 0;
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();
        } else {
            icon.className = 'bi bi-volume-up-fill fs-6';
            icon.style.color = '#38bdf8';
            if (slider) slider.value = 100;
        }
    }

    function togglePlayerMinimize() {
        document.getElementById('audioPlayerCard').classList.toggle('minimized');
    }

    function closeAdminAudioPlayer() {
        clearInterval(playerProgressInterval);
        if ('speechSynthesis' in window) window.speechSynthesis.cancel();
        document.getElementById('adminAudioPlayerWidget').classList.add('d-none');
        isPlaying = false;
    }

    function editPoiFromDetail() {
        if (!currentActiveRow) return;
        detailModalInstance.hide();
        setTimeout(() => {
            openEditPoiModalFromRow(currentActiveRow);
        }, 300);
    }

    function deletePoiFromDetail() {
        if (!currentActiveRow) return;
        const id = currentActiveRow.getAttribute('data-id');
        detailModalInstance.hide();
        deletePoi(id);
    }

    function openLightboxFromDetail() {
        const imgSrc = document.getElementById('detailPoiImage').src;
        const title = document.getElementById('detailPoiTitle').innerText;
        document.getElementById('lightboxImageTarget').src = imgSrc;
        document.getElementById('lightboxTitleCaption').innerText = title;
        imageLightboxInstance.show();
    }

    function previewModalImage(url) {
        const box = document.getElementById('modalImagePreviewBox');
        const target = document.getElementById('modalImagePreviewTarget');
        if (!url || !url.trim()) {
            box.classList.add('d-none');
            box.classList.remove('d-flex');
            return;
        }
        target.src = url.trim();
        box.classList.remove('d-none');
        box.classList.add('d-flex');
    }

    function clearModalImage() {
        document.getElementById('poiImageUrl').value = '';
        previewModalImage('');
    }

    let editingVersion = null;let editingRadius=5;
    function previewFromRow(button){const row=button.closest('tr');testScanPoi(row.dataset.code,row.dataset.title,row.dataset.desc);}
    function openCreatePoiModal() { editingVersion=null;editingRadius=5;
        document.getElementById('poiModalTitle').innerHTML = '<i class="bi bi-plus-circle-fill text-primary me-2"></i>Thêm Điểm Thuyết Minh Mới';
        document.getElementById('poiId').value = '0';
        document.getElementById('poiCode').value = '';
        document.getElementById('poiTitleVi').value = '';
        document.getElementById('poiFloor').value = '0';
        document.getElementById('poiScanCount').value = '0';
        document.getElementById('poiIsActive').value = 'true';
        document.getElementById('poiLat').value = '10.779250';
        document.getElementById('poiLng').value = '106.692250';
        document.getElementById('poiDescVi').value = '';
        document.getElementById('poiImageUrl').value = '';
        previewModalImage('');
        poiModalInstance.show();
    }

    function openEditPoiModalFromRow(row) { editingVersion=row.dataset.version;editingRadius=Number(row.dataset.radius)||5;
        document.getElementById('poiModalTitle').innerHTML = '<i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Điểm Thuyết Minh';
        document.getElementById('poiId').value = row.getAttribute('data-id') || '0';
        document.getElementById('poiCode').value = row.getAttribute('data-code') || '';
        document.getElementById('poiTitleVi').value = row.getAttribute('data-title') || '';
        document.getElementById('poiFloor').value = row.getAttribute('data-floor') || '0';
        document.getElementById('poiScanCount').value = row.getAttribute('data-scans') || '0';
        document.getElementById('poiIsActive').value = row.getAttribute('data-active') === 'true' ? 'true' : 'false';

        let rawLat = (row.getAttribute('data-lat') || '10.779250').toString().replace(',', '.');
        let rawLng = (row.getAttribute('data-lng') || '106.692250').toString().replace(',', '.');
        document.getElementById('poiLat').value = rawLat;
        document.getElementById('poiLng').value = rawLng;

        document.getElementById('poiDescVi').value = row.getAttribute('data-desc') || '';
        const imgUrl = row.getAttribute('data-image') || '';
        document.getElementById('poiImageUrl').value = imgUrl;
        previewModalImage(imgUrl);

        poiModalInstance.show();
    }

    // GỬI YÊU CẦU LƯU POI VÀO CSDL KÈM TỰ ĐỘNG DỊCH THUẬT
    function savePoiToDb(e) {
        e.preventDefault();

        let latVal = parseFloat(document.getElementById('poiLat').value.toString().replace(',', '.'));
        let lngVal = parseFloat(document.getElementById('poiLng').value.toString().replace(',', '.'));
        let scansVal = parseInt(document.getElementById('poiScanCount').value) || 0;
        let poiIdVal = parseInt(document.getElementById('poiId').value) || 0;

        const payload = {
            id: poiIdVal,
            code: document.getElementById('poiCode').value.trim(),
            titleVi: document.getElementById('poiTitleVi').value.trim(),
            descVi: document.getElementById('poiDescVi').value.trim(),
            floor: parseInt(document.getElementById('poiFloor').value) || 0,
            rowVersion: editingVersion,
            triggerRadiusMeters: editingRadius,
            lat: latVal,
            lng: lngVal,
            imageUrl: document.getElementById('poiImageUrl').value.trim(),
            isActive: document.getElementById('poiIsActive').value === 'true'
        };

        const submitButton = document.querySelector('#poiForm button[type=submit]') || document.querySelector('button[form=poiForm][type=submit]');
        if (submitButton) submitButton.disabled = true;
        apiFetch('/Home/SavePoi', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(data => {
            alert("✓ " + (data.message || "Đã lưu thành công dữ liệu vào CSDL SQL Server!"));
            location.reload();
        })
        .catch(err => {
            alert(err.message);
        }).finally(() => { if (submitButton) submitButton.disabled = false; });
    }

    function togglePoiStatus(id) {
        apiFetch(`/Home/ToggleStatus?id=${id}`, { method: 'POST' })
            .then(() => location.reload())
            .catch(err => alert("Không thể thay đổi trạng thái: " + err.message));
    }

    function deletePoi(id) {
        if (confirm("Bạn có chắc chắn muốn xóa địa điểm này khỏi CSDL SQL Server không?")) {
            apiFetch(`/Home/DeletePoi?id=${id}`, { method: 'DELETE' })
                .then(data => {
                    alert("✓ " + (data.message || "Đã xóa địa điểm khỏi CSDL thành công!"));
                    location.reload();
                })
                .catch(err => alert("Không thể xóa địa điểm: " + err.message));
        }
    }
</script>
