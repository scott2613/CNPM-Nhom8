@* Import thư viện CultureInfo để định dạng tọa độ GPS không phụ thuộc Locale máy chủ *@
@using System.Globalization
@* Khai báo Model danh sách địa điểm thuyết minh từ HomeController *@
@model IEnumerable<AudioGuide.Admin.Controllers.PoiAdminViewModel>

@{
    ViewData["Title"] = "Quản lý Thuyết minh tự động đa ngôn ngữ";

    // Tính tổng tất cả các lượt truy cập từ du khách
    var totalScans = Model?.Sum(p => p.ScanCount) ?? 0;

    // Sắp xếp danh sách POI ưu tiên theo thứ tự hiển thị (SortOrder), sau đó đến số trong mã Code hoặc Id
    var sortedPois = Model?.OrderBy(p =>
    {
        if (p.SortOrder > 0) return p.SortOrder;
        string cleanNum = new string((p.Code ?? "").Where(char.IsDigit).ToArray());
        return int.TryParse(cleanNum, out int val) ? val : p.Id;
    }).ToList();
}

