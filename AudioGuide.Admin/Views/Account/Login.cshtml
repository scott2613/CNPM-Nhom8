@{ Layout=null; }
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đăng nhập AudioGuide</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
<style>body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:system-ui;background:var(--admin-page-background) fixed;color:#0f172a}.card{width:min(360px,80vw);padding:36px;border:1px solid white;border-radius:28px;background:#ffffff99;backdrop-filter:blur(22px);box-shadow:0 20px 60px #0284c733}label{display:block;margin-top:18px}input,button{box-sizing:border-box;width:100%;padding:12px;border:1px solid #bae6fd;border-radius:12px;font:inherit}button{margin-top:24px;justify-content:center}.validation-summary-errors{color:#b91c1c}</style></head>
<body><main class="card"><h1>AudioGuide Admin</h1>@if (ViewBag.Setup == true)
{
    <p>Thiết lập tài khoản <strong>@ViewBag.Username</strong> cho hệ thống.</p>
    <form asp-action="Setup" method="post">
        <div asp-validation-summary="All"></div>
        <label for="newPassword">Mật khẩu mới (ít nhất 4 ký tự)</label>
        <input id="newPassword" name="password" type="password" autocomplete="new-password" minlength="4" maxlength="1024" required autofocus>
        <label for="confirmPassword">Nhập lại mật khẩu</label>
        <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required maxlength="1024">
        <button class="btn-liquid-lens" type="submit">Tạo mật khẩu</button>
    </form>
}
else
{
<p>Đăng nhập để quản lý nội dung và thống kê.</p>
@if (TempData["SetupComplete"] is string message) { <p role="status">@message</p> }<form asp-action="Login" method="post"><div asp-validation-summary="All"></div><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"><label for="username">Tên đăng nhập</label><input id="username" name="username" autocomplete="username" required maxlength="100" value="@ViewBag.Username"><label for="password">Mật khẩu</label><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="1024"><button class="btn-liquid-lens" type="submit">Đăng nhập</button></form>
}
</main></body></html>
